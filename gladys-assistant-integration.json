        "en": "Read a printer",
        "fr": "Relire une imprimante",
        "de": "Drucker abfragen",
        "es": "Leer una impresora"
      },
      "description": {
        "en": "Reads the printer now and passes on its page count, lowest supply and status to the next actions.",
        "fr": "Lit l'imprimante maintenant et transmet aux actions suivantes ses pages, son consommable le plus bas et son état.",
        "de": "Fragt den Drucker sofort ab und gibt Seitenzahl, niedrigsten Füllstand und Status an die nächsten Aktionen weiter.",
        "es": "Lee la impresora ahora y pasa a las acciones siguientes sus páginas, su consumible más bajo y su estado."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "printer",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Printer",
            "fr": "Imprimante",
            "de": "Drucker",
            "es": "Impresora"
          },
          "required": true
