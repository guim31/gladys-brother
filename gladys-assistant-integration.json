{
  "manifest_version": 1,
  "type": "device",
  "name": "Brother Printers",
  "description": {
    "en": "Toner, ink, drum and page counters of your Brother printers over SNMP. Local, no cloud.",
    "fr": "Toner, encre, tambour et compteurs de pages de vos imprimantes Brother en SNMP. Local.",
    "de": "Toner, Tinte, Trommel und Seitenzähler deiner Brother-Drucker per SNMP. Lokal, ohne Cloud.",
    "es": "Tóner, tinta, tambor y contadores de páginas de sus impresoras Brother por SNMP. Local."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/guim31/gladys-brother:1.0.2",
  "gladys_version": ">=5.1.0",
  "categories": ["appliances", "network"],
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-brother/main/cover.png",
  "transports": ["local"],
  "network_discovery": [
    { "type": "mdns", "service": "_printer._tcp" },
    { "type": "mdns", "service": "_ipp._tcp" }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "Funktionsweise",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Brother printers on your network are found automatically (mDNS) and read over SNMP: toner or ink, drum, belt, fuser and other wear parts, page counters and the message on the display. SNMP must be enabled on the printer (it is by default). Add the IP address below if a printer is not found.",
        "fr": "Les imprimantes Brother de votre réseau sont trouvées automatiquement (mDNS) et lues en SNMP : toner ou encre, tambour, courroie, unité de fusion et autres pièces d'usure, compteurs de pages et message de l'écran. Le SNMP doit être activé sur l'imprimante (il l'est par défaut). Saisissez l'adresse IP ci-dessous si une imprimante n'est pas trouvée.",
        "de": "Brother-Drucker in deinem Netzwerk werden automatisch gefunden (mDNS) und per SNMP gelesen: Toner oder Tinte, Trommel, Transfereinheit, Fixiereinheit und weitere Verschleißteile, Seitenzähler und die Meldung im Display. SNMP muss am Drucker aktiviert sein (ab Werk ist es das). Trage unten die IP-Adresse ein, wenn ein Drucker nicht gefunden wird.",
        "es": "Las impresoras Brother de su red se encuentran automáticamente (mDNS) y se leen por SNMP: tóner o tinta, tambor, correa, unidad de fusión y otras piezas de desgaste, contadores de páginas y el mensaje de la pantalla. SNMP debe estar activado en la impresora (lo está de fábrica). Introduzca la dirección IP abajo si no se encuentra una impresora."
      }
    },
    {
      "key": "printer_hosts",
      "type": "string",
      "label": {
        "en": "Printers (IP addresses)",
        "fr": "Imprimantes (adresses IP)",
        "de": "Drucker (IP-Adressen)",
        "es": "Impresoras (direcciones IP)"
      },
      "description": {
        "en": "Optional. IP addresses separated by commas, for printers the automatic discovery does not find. A .local name does not work here.",
        "fr": "Optionnel. Adresses IP séparées par des virgules, pour les imprimantes que la découverte automatique ne trouve pas. Un nom .local ne fonctionne pas ici.",
        "de": "Optional. IP-Adressen, durch Kommas getrennt, für Drucker, die die automatische Erkennung nicht findet. Ein .local-Name funktioniert hier nicht.",
        "es": "Opcional. Direcciones IP separadas por comas, para las impresoras que el descubrimiento automático no encuentra. Un nombre .local no funciona aquí."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20, 192.168.1.21",
        "fr": "ex. 192.168.1.20, 192.168.1.21",
        "de": "z. B. 192.168.1.20, 192.168.1.21",
        "es": "p. ej. 192.168.1.20, 192.168.1.21"
      },
      "required": false
    },
    {
      "key": "community",
      "type": "secret",
      "label": {
        "en": "SNMP community",
        "fr": "Communauté SNMP",
        "de": "SNMP-Community",
        "es": "Comunidad SNMP"
      },
      "description": {
        "en": "Leave empty to use \"public\", the printer's factory setting.",
        "fr": "Laissez vide pour utiliser « public », le réglage d'usine de l'imprimante.",
        "de": "Leer lassen, um „public“ zu verwenden, die Werkseinstellung des Druckers.",
        "es": "Déjelo vacío para usar «public», el ajuste de fábrica de la impresora."
      },
      "required": false
    },
    {
      "key": "snmp_version",
      "type": "select",
      "label": {
        "en": "SNMP version",
        "fr": "Version SNMP",
        "de": "SNMP-Version",
        "es": "Versión de SNMP"
      },
      "description": {
        "en": "v1 works with every Brother printer. Choose v2c only if v1 is disabled on the printer.",
        "fr": "La v1 fonctionne avec toutes les imprimantes Brother. Choisissez la v2c seulement si la v1 est désactivée sur l'imprimante.",
        "de": "v1 funktioniert mit jedem Brother-Drucker. Wähle v2c nur, wenn v1 am Drucker deaktiviert ist.",
        "es": "La v1 funciona con todas las impresoras Brother. Elija la v2c solo si la v1 está desactivada en la impresora."
      },
      "required": false,
      "default": "1",
      "options": [
        { "value": "1", "label": { "en": "v1", "fr": "v1", "de": "v1", "es": "v1" } },
        { "value": "2c", "label": { "en": "v2c", "fr": "v2c", "de": "v2c", "es": "v2c" } }
      ]
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Reading interval (s)",
        "fr": "Intervalle de lecture (s)",
        "de": "Abfrageintervall (s)",
        "es": "Intervalo de lectura (s)"
      },
      "description": {
        "en": "How often each printer is read, in seconds (one small SNMP request). 60 s reports a paper jam within a minute.",
        "fr": "Fréquence de lecture de chaque imprimante, en secondes (une petite requête SNMP). 60 s signalent un bourrage en moins d'une minute.",
        "de": "Wie oft jeder Drucker abgefragt wird, in Sekunden (eine kleine SNMP-Anfrage). Mit 60 s wird ein Papierstau innerhalb einer Minute gemeldet.",
        "es": "Frecuencia de lectura de cada impresora, en segundos (una pequeña petición SNMP). Con 60 s, un atasco se señala en menos de un minuto."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Names of the sensors of newly added printers, and texts sent to scenes.",
        "fr": "Noms des capteurs des imprimantes nouvellement ajoutées, et textes envoyés aux scènes.",
        "de": "Namen der Sensoren neu hinzugefügter Drucker und Texte, die an Szenen gehen.",
        "es": "Nombres de los sensores de las impresoras añadidas a partir de ahora, y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": { "en": "English", "fr": "Anglais", "de": "Englisch", "es": "Inglés" }
        },
        {
          "value": "fr",
          "label": { "en": "French", "fr": "Français", "de": "Französisch", "es": "Francés" }
        },
        {
          "value": "de",
          "label": { "en": "German", "fr": "Allemand", "de": "Deutsch", "es": "Alemán" }
        },
        {
          "value": "es",
          "label": { "en": "Spanish", "fr": "Espagnol", "de": "Spanisch", "es": "Español" }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_printer",
      "label": {
        "en": "Test a printer",
        "fr": "Tester une imprimante",
        "de": "Drucker testen",
        "es": "Probar una impresora"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "host",
          "type": "string",
          "label": {
            "en": "IP address",
            "fr": "Adresse IP",
            "de": "IP-Adresse",
            "es": "Dirección IP"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "supply_low",
